// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  BETA
}

model User {
  id               String      @id @default(cuid())
  clerkId          String      @unique
  email            String      @unique
  name             String?
  imageUrl         String?
  plan             Plan        @default(FREE)
  /// Set when a PRO subscription is cancelled: Pro access continues until this moment (end of the
  /// period already paid for), then `lapseExpiredPro` returns the user to FREE. Null = no scheduled end.
  proExpiresAt     DateTime?
  generationsLeft  Int         @default(10)
  /// Generations taken on the day of `lastGenerationDate`, compared against the effective plan's
  /// daily ceiling (src/lib/plans.ts). A new day resets it to 0 on the next reservation.
  generationsUsedToday Int     @default(0)
  /// Capped refunds (malformed or truncated model output) given back on the day of
  /// `lastGenerationDate`. At most MAX_CAPPED_REFUNDS_PER_DAY (src/lib/generationCredits.ts) per day,
  /// so deliberately broken requests cannot make the daily ceiling meaningless. Reset with
  /// `generationsUsedToday`.
  generationRefundsToday Int   @default(0)
  lastGenerationDate DateTime?
  imagesLeft       Int         @default(1)
  lastImageDate    DateTime?
  stripeCustomerId String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  classrooms       Classroom[]
}

/// One row per PayFast notification (ITN) we accepted. Gives an audit trail for reconciling money
/// against plans, and `pfPaymentId` makes redelivered notifications detectable.
model Payment {
  id          String   @id @default(cuid())
  pfPaymentId String   @unique
  mPaymentId  String?
  clerkId     String
  status      String
  amountGross String?
  createdAt   DateTime @default(now())

  @@index([clerkId, createdAt])
}

model Classroom {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Profile
  name              String
  subject           String
  grade             String
  curriculum        String
  studentCount      Int      @default(30)
  averagePercentile Int      @default(65)
  teachingNotes     String   @default("")
  
  // Advanced Student Customization
  learningStyles    String[] @default([])
  accommodations    String?
  studentInterests  String?

  // Rich data stored as JSON (arrays of weeks/students)
  blueprint         Json?    // Blueprint type — JSON serialized
  students          Json?    // Student[] array — JSON serialized
  assessmentColumns Json?    // string[] array — JSON serialized
  savedLessons      Json?    // Record<unitKey, LessonContent> — JSON serialized
  analysis          Json?    // ClassAnalysis type — JSON serialized

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Optimistic-locking counter: bumped on every write. A client that sends the version it last saw
  // is rejected (409) if someone else saved in between, instead of silently overwriting their data.
  version           Int      @default(0)

  // Every classroom query is "this user's classrooms, newest first". Postgres does not index
  // foreign keys automatically, so without this the list query scans the whole table.
  @@index([userId, updatedAt])
}
