# Copy this file to .env.test and fill in real values.
# .env.test is gitignored — never commit real secrets here.
#
# Setup:
#   1. cp .env.test.example .env.test
#   2. npm run test:db:up        (starts the isolated Postgres in docker-compose.test.yml)
#   3. DATABASE_URL below already points at that container by default — leave as-is
#   4. npx prisma migrate deploy  (applies migrations to the test DB, first run only)
#   5. npm test
#   6. npm run test:db:down       (when done)
#
# tests/global.setup.ts WIPES all Classroom and User rows in whatever DATABASE_URL
# points to before every run. NEVER point this at a real/shared database.

DATABASE_URL="postgresql://testuser:testpassword@localhost:5433/edumaster_test"

# Needed by tests/api/webhooks.spec.ts to generate a valid PayFast signature.
# Use the same sandbox passphrase configured in your .env.local — this is not
# a secret that grants access to anything, it's a shared signing key for the
# PayFast sandbox integration.
PAYFAST_PASSPHRASE=
