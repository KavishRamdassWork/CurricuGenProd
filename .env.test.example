# Copy this file to .env.test and fill in real values.
# .env.test is gitignored — never commit real secrets here.
#
# Setup:
#   1. cp .env.test.example .env.test
#   2. npm run test:db:up        (starts the isolated Postgres in docker-compose.test.yml)
#   3. DATABASE_URL below already points at that container by default — leave as-is
#   4. npx prisma migrate deploy  (applies migrations to the test DB, first run only)
#   5. npm test
#   6. npm run test:db:down       (when done)
#
# tests/global.setup.ts WIPES all Classroom and User rows before every run (the "setup"
# project). It refuses to run unless DATABASE_URL points at localhost/127.0.0.1, but still:
# NEVER point this at a real/shared database. Use --no-deps to skip the setup project.

DATABASE_URL="postgresql://testuser:testpassword@localhost:5433/edumaster_test"

# Needed by tests/api/webhooks.spec.ts to generate a valid PayFast signature.
# Use the same sandbox passphrase configured in your .env.local — this is not
# a secret that grants access to anything, it's a shared signing key for the
# PayFast sandbox integration.
PAYFAST_PASSPHRASE=

# Optional. Comma-separated list of beta tester email addresses. This list is the source of truth for
# beta access: it is resolved on every request, so removing an email ends beta access on the next request.
# Stored BETA plan rows for emails not on this list count as FREE. Put the owner's own address here to
# test beta access.
# BETA_TESTER_EMAILS=tester1@example.com,tester2@example.com

# Optional kill switch. Set to "true" to make every /api/generate/* route return 503 immediately.
# AI_GENERATION_DISABLED=true

# Only for the manual live prompt-injection smoke test (never part of normal runs; calls the real Gemini API).
# Run: RUN_LIVE_INJECTION_SMOKE=1 npx playwright test tests/live/injection-smoke.spec.ts --project=chromium --no-deps
# RUN_LIVE_INJECTION_SMOKE=1
# GEMINI_API_KEY=
